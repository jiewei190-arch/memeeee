# Never commit the real webhook URL.
SLACK_WEBHOOK_URL=

# Comma-separated DEX Screener chain IDs. Override a chain ID if a provider
# changes it; unavailable chains are reported in health rather than hidden.
CHAINS=solana,ethereum,base,bsc,monad,robinhoodchain
SCAN_INTERVAL_SECONDS=30
HEARTBEAT_MINUTES=60
DAILY_SUMMARY_HOUR_UTC=21
DATABASE_PATH=/data/fomo-sentinel.db

# Quality gates (tune only after reviewing recorded outcomes).
MIN_LIQUIDITY_USD=25000
MIN_HOURLY_VOLUME_USD=10000
MIN_MARKET_CAP_USD=50000
MAX_MARKET_CAP_USD=20000000
MIN_PAIR_AGE_MINUTES=5
MAX_PAIR_AGE_HOURS=24
MIN_HOURLY_TRADES=20
MIN_LIQUIDITY_TO_MCAP=0.025
ALERT_SCORE=76
REQUIRED_CONFIRMATIONS=2
ALERT_COOLDOWN_HOURS=8

# Precision mode fails closed: a coin cannot alert if its chain-specific safety
# report is missing or inconclusive.
REQUIRE_SECURITY_CHECK=true
MAX_TOP_10_HOLDER_PERCENT=35
RUGCHECK_BASE_URL=https://api.rugcheck.xyz/v1
GOPLUS_BASE_URL=https://api.gopluslabs.io/api/v1
ROBINHOOD_BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
